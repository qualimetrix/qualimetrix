includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
    level: 8
    parallel:
        maximumNumberOfProcesses: 4
        processTimeout: 300.0
        jobSize: 10
    paths:
        - src
        - tests
        - governance
        - scripts
        - tools
    excludePaths:
        - tests/Infrastructure/Ast/Fixtures
        - tests/Infrastructure/Console/Fixtures
        - tests/Analysis/Evidence/Design/Fixtures
        - tests/Analysis/Evidence/Measurement/Fixtures
        - tests/Analysis/Policy/Architecture/Fixtures
        - tests/Analysis/Policy/Baseline/Fixtures
        - tests/Analysis/Policy/Inline/Fixtures
        - governance/FormatOptionKeys/Fixtures
        - governance/SelectorSyntax/Fixtures
        - tools/phpstan/tests/Fixtures
    tmpDir: .phpstan.cache
    reportUnmatchedIgnoredErrors: true
    ignoreErrors:
        # One authored form in the agreement fixture is a target the product
        # refuses to read — `(paren.wrapped)` — and PHPDoc cannot parse it
        # either. The file is analysed like any other; only the one shape it
        # exists to state is ignored, and `reportUnmatchedIgnoredErrors` turns
        # the day it stops being written into a failure.
        -
            identifier: phpDoc.parseError
            path: scripts/directive-audit/tests/Fixtures/AuthoredThresholdForms.php
    treatPhpDocTypesAsCertain: false

services:
    # ADR 0015 Phase 6: regression guard against re-introducing string-typed
    # properties that should travel through the Path VOs.
    -
        class: Qualimetrix\PhpStan\Rules\PathPropertyMatcher
    -
        class: Qualimetrix\PhpStan\Rules\BannedStringPathPropertyRule
        tags:
            - phpstan.rules.rule
    -
        class: Qualimetrix\PhpStan\Rules\BannedStringPathPromotedPropertyRule
        tags:
            - phpstan.rules.rule
