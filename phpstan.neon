includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
    level: 8
    parallel:
        maximumNumberOfProcesses: 4
        processTimeout: 300.0
        jobSize: 10
    paths:
        - src
        - tests
    excludePaths:
        - tests/Fixtures
        - tests/Analysis/Evidence/Measurement/Fixtures
        - tests/Analysis/Policy/Architecture/Fixtures
        - tests/Analysis/Policy/Baseline/Fixtures
        - tests/Analysis/Policy/Inline/Fixtures
        - tests/Architecture/Fixtures
        - tests/Unit/PhpStan/Rules/data
    tmpDir: .phpstan.cache
    reportUnmatchedIgnoredErrors: true
    treatPhpDocTypesAsCertain: false

services:
    # ADR 0015 Phase 6: regression guard against re-introducing string-typed
    # properties that should travel through the Path VOs.
    -
        class: Qualimetrix\PhpStan\Rules\PathPropertyMatcher
    -
        class: Qualimetrix\PhpStan\Rules\BannedStringPathPropertyRule
        tags:
            - phpstan.rules.rule
    -
        class: Qualimetrix\PhpStan\Rules\BannedStringPathPromotedPropertyRule
        tags:
            - phpstan.rules.rule
