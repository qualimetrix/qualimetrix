# Git and version control
.git
.gitignore
.gitattributes

# Dependencies (will be installed in container)
vendor/
composer.lock
node_modules/

# Development files
.env
.env.*.local
.vscode/
.idea/
*.swp
*.swo
*~

# Build and cache directories
build/
dist/
.cache/

# Test outputs and coverage
tests/
governance/
phpunit.xml*
coverage/
.phpunit.cache/

# Nested test directories under tooling roots (e.g. tools/phpstan/tests/):
# the root-anchored tests/ entry above does not reach them. Matched both ways
# so the exclusion does not depend on settling Docker's glob semantics.
**/tests/
tools/phpstan/tests/

# Examples and documentation (reference only)
examples/
docs/

# Docker files
docker-compose.*.yml
docker-compose.override.yml
Dockerfile.*

# OS-specific files
.DS_Store
Thumbs.db
.directory

# Project-specific ignores
baseline*.json
results*.sarif
results*.json
*.log
.php-version
