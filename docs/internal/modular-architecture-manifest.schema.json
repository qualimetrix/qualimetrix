{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://qualimetrix.dev/internal/modular-architecture-manifest.schema.json",
    "title": "Qualimetrix internal modular architecture manifest",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "version",
        "owners",
        "declarations",
        "enforcement_seams"
    ],
    "properties": {
        "version": {
            "const": 4
        },
        "owners": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z0-9]*(\\.[A-Z][A-Za-z0-9]*)*$"
            }
        },
        "declarations": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/$defs/declaration"
            }
        },
        "enforcement_seams": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/$defs/seam"
            }
        }
    },
    "$defs": {
        "declaration": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path",
                "kind",
                "owner",
                "visibility",
                "consumers"
            ],
            "properties": {
                "path": {
                    "type": "string",
                    "pattern": "^src/.+\\.php$"
                },
                "kind": {
                    "enum": [
                        "class",
                        "interface",
                        "trait",
                        "enum"
                    ]
                },
                "owner": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Za-z0-9]*(\\.[A-Z][A-Za-z0-9]*)*$"
                },
                "visibility": {
                    "enum": [
                        "internal",
                        "contract"
                    ]
                },
                "consumers": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/consumer"
                    }
                }
            }
        },
        "consumer": {
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "owner",
                        "source_fqcn"
                    ],
                    "properties": {
                        "owner": {
                            "type": "string",
                            "pattern": "^[A-Z][A-Za-z0-9]*(\\.[A-Z][A-Za-z0-9]*)*$"
                        },
                        "source_fqcn": {
                            "type": "null"
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "owner",
                        "source_fqcn"
                    ],
                    "properties": {
                        "owner": {
                            "type": "string",
                            "pattern": "^[A-Z][A-Za-z0-9]*(\\.[A-Z][A-Za-z0-9]*)*$"
                        },
                        "source_fqcn": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "owner",
                        "relation",
                        "source_fqcn",
                        "carrier_fqcn",
                        "boundary_fqcn"
                    ],
                    "properties": {
                        "owner": {
                            "type": "string",
                            "pattern": "^[A-Z][A-Za-z0-9]*(\\.[A-Z][A-Za-z0-9]*)*$"
                        },
                        "relation": {
                            "const": "contract_composition"
                        },
                        "source_fqcn": {
                            "type": "null"
                        },
                        "carrier_fqcn": {
                            "type": "string",
                            "minLength": 1
                        },
                        "boundary_fqcn": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "owner",
                        "relation",
                        "source_fqcn",
                        "carrier_fqcn"
                    ],
                    "properties": {
                        "owner": {
                            "type": "string",
                            "pattern": "^[A-Z][A-Za-z0-9]*(\\.[A-Z][A-Za-z0-9]*)*$"
                        },
                        "relation": {
                            "const": "contract_surface"
                        },
                        "source_fqcn": {
                            "type": "string",
                            "minLength": 1
                        },
                        "carrier_fqcn": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "owner",
                        "relation",
                        "source_fqcn",
                        "operations"
                    ],
                    "properties": {
                        "owner": {
                            "const": "Infrastructure.DependencyInjection"
                        },
                        "relation": {
                            "const": "composition_binding"
                        },
                        "source_fqcn": {
                            "type": "string",
                            "minLength": 1
                        },
                        "operations": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                                "enum": [
                                    "service_registration",
                                    "definition_argument_mutation",
                                    "service_reference",
                                    "service_alias",
                                    "conditional_service_reference"
                                ]
                            }
                        }
                    }
                }
            ]
        },
        "seam": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "semantic_owner",
                "layer"
            ],
            "properties": {
                "semantic_owner": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Za-z0-9]*(\\.[A-Z][A-Za-z0-9]*)*$"
                },
                "layer": {
                    "type": "string",
                    "pattern": "^seam-[a-z0-9]+(-[a-z0-9]+)*$"
                }
            }
        }
    }
}
