{
    "main": "bin/qmx",
    "output": "build/qmx.phar",
    "compression": "NONE",
    "check-requirements": false,
    "compactors": [
        "KevinGH\\Box\\Compactor\\Php",
        "KevinGH\\Box\\Compactor\\Json"
    ],
    "files": [
        "LICENSE",
        "html-report/report.html",
        "html-report/report.css",
        "html-report/dist/d3.min.js",
        "html-report/dist/report.min.js"
    ],
    "finder": [
        {
            "in": [
                "src"
            ],
            "notName": [
                "README.md"
            ]
        },
        {
            "in": [
                "vendor"
            ],
            "notPath": [
                "#^bin/#"
            ],
            "ignoreVCS": true
        }
    ]
}
