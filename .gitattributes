* text=auto eol=lf
*.phar binary
*.php diff=php

# The source inventory encodes absent terminal TSV cells with a trailing tab.
promise-effect/config-paths.tsv whitespace=-blank-at-eol
promise-effect/promise-ledger-frozen-ranges.tsv whitespace=-blank-at-eol
promise-effect/promise-ledger.tsv whitespace=-blank-at-eol

# Exclude from composer dist package
/.github/               export-ignore
/.githooks/             export-ignore
/docs/                  export-ignore
/tests/                 export-ignore
/governance/            export-ignore
/scripts/               export-ignore
/tools/                 export-ignore
/directive-audit/**     export-ignore
/finding-gate/**        export-ignore
/input-doors/**         export-ignore
/promise-effect/**      export-ignore
/defect-ledger/**       export-ignore
/benchmark-results/     export-ignore
/coverage/              export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/.editorconfig          export-ignore
/.dockerignore          export-ignore
/.php-cs-fixer.dist.php export-ignore
/phpunit.xml.dist       export-ignore
/phpstan.neon           export-ignore
/deptrac.yaml           export-ignore
/docker-compose.yml     export-ignore
/Dockerfile             export-ignore
/CLAUDE.md              export-ignore
/baseline.json          export-ignore
/profile.json           export-ignore
/.claude/               export-ignore
/.serena/               export-ignore
/benchmarks/            export-ignore
/website/               export-ignore

# Generated ratchet snapshot: collapse its diff by default in both forges
qmx-baseline.json linguist-generated
qmx-baseline.json gitlab-generated

# Stage 05 verdicts are appended, never rewritten: union-merge them.
defect-ledger/verdicts/*.tsv merge=union
