#!/bin/bash

# Commit-msg hook for Qualimetrix
# Validates commit message format

COMMIT_MSG_FILE=$1
HOOK_DIR="$(dirname "$0")"

# Private disclosure guard. A commit message is not covered by the file-content
# check, and scrubbing one afterwards needs a full history rewrite — so refuse
# before the commit exists.
if ! bash "$HOOK_DIR/../scripts/check-private-leaks.sh" --message "$COMMIT_MSG_FILE"; then
    echo ""
    echo "❌ Refusing to commit: private term in the commit message"
    exit 1
fi

# Conventional Commits. The rule lives in the script because CI applies the same
# one to the commits a pull request adds; the script also decides which subjects
# a hook may judge at all, which is not the same question as which subjects are
# valid. See the header of scripts/check-commit-subject.sh.
if ! bash "$HOOK_DIR/../scripts/check-commit-subject.sh" --message "$COMMIT_MSG_FILE"; then
    exit 1
fi

exit 0
