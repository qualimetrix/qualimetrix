* text=auto eol=lf
*.phar binary
*.php diff=php

# Composer dist package: an allowlist. Everything at the root is excluded, then
# exactly what a consumer runs is let back in, so a new development directory
# stays out of the package without anyone remembering to list it. The phar's
# include list (box.json) must not carry anything this file keeps out; that
# pairing is held by governance/DistributedPackage.
/*                       export-ignore
/src                     -export-ignore
/src/**/README.md        export-ignore
/bin                     -export-ignore
/composer.json           -export-ignore
/LICENSE                 -export-ignore
/README.md               -export-ignore
/qmx.yaml.example        -export-ignore
# The HTML report is an npm project; HtmlFormatter reads only these four assets.
/html-report             -export-ignore
/html-report/*           export-ignore
/html-report/report.html -export-ignore
/html-report/report.css  -export-ignore
/html-report/dist        -export-ignore

# Generated ratchet snapshot: collapse its diff by default in both forges
qmx-baseline.json linguist-generated
qmx-baseline.json gitlab-generated

