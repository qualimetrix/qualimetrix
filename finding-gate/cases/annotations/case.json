{
    "id": "annotations",
    "description": "Four deliberately broken inline @qmx directives: unresolved, unsupported, unparseable, unused.",
    "paths": [
        "src"
    ],
    "config": "qmx.yaml",
    "args": [
        "--rule-opt=coupling.class-rank:warning=2",
        "--rule-opt=coupling.class-rank:error=2",
        "--rule-opt=coupling.distance:max_distance_warning=2",
        "--rule-opt=coupling.distance:max_distance_error=2"
    ],
    "channels": [
        "annotation.invalid-threshold#annotation.invalid-threshold",
        "annotation.unresolved-directive#annotation.unresolved-directive",
        "annotation.unsupported-threshold#annotation.unsupported-threshold",
        "annotation.unused-directive#annotation.unused-directive"
    ],
    "explainSubjects": [
        "file:src/Directives.php"
    ]
}
