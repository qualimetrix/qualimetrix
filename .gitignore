.deptrac.cache

# PHP-CS-Fixer
.php-cs-fixer.cache

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Cache
/.cache/
/var/cache/

# Logs
*.log

# Build artifacts
/build/
/dist/
/site/
/_site/
website/site/

# Python venv and cache (MkDocs)
/.venv/
website/.venv/
__pycache__/

# Test fixtures (generated)
/tests/Fixtures/generated/
.qmx-cache/

# Demo/example files
examples/
*.json
!/qmx-baseline.json
/qmx-baseline.json.lock
!/docs/internal/benchmark-baselines.json
# The namespace/class half of the same guard. Written by the same command as
# the baselines above; without this line the blanket *.json swallows it, the
# guard reports a file it wrote, and nothing outside one machine is guarded.
!/docs/internal/benchmark-namespace-class-distribution.json
# The stand's frozen "before" side: 858 files the blanket *.json above swallowed
# in silence, which left the round's own evidence unreproducible outside one
# machine — the very shape of defect that round was about.
!/docs/internal/generated/input-doors/observations-before/**/*.json
!/docs/internal/modular-architecture-manifest.json
!/docs/internal/modular-architecture-manifest.schema.json
!/tests/Fixtures/**/*.json
!/tests/Analysis/Evidence/Measurement/Fixtures/*.json
!/tests/Analysis/Policy/Architecture/Fixtures/Sample/*.json
!/tests/Analysis/Policy/Baseline/Fixtures/BaselineV10/memory-ceiling.json
!/benchmarks/composer.json
!/finding-gate/**/*.json
# The promise-effect probe fixture: the blanket `*.json` above would swallow
# its composer.json, and a fixture that a fresh clone cannot reproduce makes
# every digest in the frozen snapshot unverifiable.
!/promise-effect/fixtures/**/*.json
# Output-format fixtures: their composer.json sets the PSR-4 root the analysed
# code needs, and breach/baseline.json is the accepted ceiling whose exceeding
# is the only route to a non-null `acceptedLevel`. Swallowed, the guard's
# scenarios cannot be reproduced from a fresh clone.
!/tests/System/DocumentationConsistency/Fixtures/**/*.json
# HTML report build manifest: without these the JS bundle cannot be rebuilt or
# audited from a fresh clone, and dependency versions cannot be pinned.
!/src/Reporting/Template/package.json
!/src/Reporting/Template/package-lock.json

# Node modules (HTML report build pipeline)
node_modules/

# Playwright CLI artifacts
.playwright-cli/

# Benchmarks (vendor is downloaded; composer.lock is tracked so health-score
# calibration stays reproducible against fixed Laravel/Symfony/Doctrine versions)
/benchmarks/vendor/

# Agent tooling scratch (Serena) — local only, must not reach the public repo
.serena/

# Machine-local benchmark configuration: private project names, sizes and
# filesystem paths must never be committed. See benchmarks/*.example.
/benchmarks/local.env
/benchmarks/local-projects.json
/scripts/private-terms.local.txt

# Claude Code scheduler lock (runtime artifact)
.claude/scheduled_tasks.lock

# Benchmark timing output (regenerated by scripts/benchmark-comparison.sh)
/benchmark-results/

# Working artifacts of a plan review: briefs and per-reviewer findings.
# Kept out of the tree deliberately — the plan carries the disposition, these
# carry the evidence behind it. scripts/check-review-disposition.sh cross-checks
# the two and skips cleanly when they are absent, as on a fresh clone.
review-*/
