#!/usr/bin/env php
<?php

declare(strict_types=1);

namespace Qualimetrix;

use Qualimetrix\Infrastructure\Console\Application;
use Qualimetrix\Infrastructure\Console\ConsoleDiagnostics;
use Qualimetrix\Infrastructure\Console\Refusal\OutOfMemoryHint;
use Qualimetrix\Infrastructure\DependencyInjection\ContainerFactory;

// Before the autoloader, because src/ uses syntax older interpreters cannot
// parse: without this the first failure is a parse error naming a file the
// reader did not open. The floor is composer.json's `php` constraint, and a
// governance control holds the two together — this literal cannot read
// composer.json, which the dist ships but the phar deliberately does not.
if (\PHP_VERSION_ID < 80400) {
    fwrite(
        \STDERR,
        \sprintf("Environment error: Qualimetrix needs PHP 8.4 or newer; this is PHP %s.\n", \PHP_VERSION),
    );
    exit(3);
}

// Find autoloader
$autoloadPaths = [
    __DIR__ . '/../vendor/autoload.php',           // Local development
    __DIR__ . '/../../../autoload.php',             // Installed as dependency
];

$autoloaderFound = false;
foreach ($autoloadPaths as $autoloadPath) {
    if (file_exists($autoloadPath)) {
        require_once $autoloadPath;
        $autoloaderFound = true;
        break;
    }
}

if (!$autoloaderFound) {
    fwrite(\STDERR, "Environment error: Could not find autoloader. Run 'composer install'.\n");
    exit(3);
}

$hint = OutOfMemoryHint::register();
exit(Application::forProduct(
    static fn(ConsoleDiagnostics $diagnostics) => (new ContainerFactory())->create($diagnostics),
    $hint,
)->run());
