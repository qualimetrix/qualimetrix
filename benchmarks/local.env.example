# Copy to benchmarks/local.env and point these at your own checkouts.
# That file is git-ignored: private paths must never enter this repository.
#
# Used by scripts/benchmark-comparison.sh. Both are optional — the medium target
# falls back to a globally installed laravel/framework, and the large target is
# skipped entirely when unset.

# Mid-size open-source codebase (~10k files) used for timing comparisons.
QMX_BENCH_MEDIUM="$HOME/.composer/vendor/laravel/framework/src"

# Large codebase (~10k files) used for scaling comparisons. May be private.
QMX_BENCH_LARGE=""
