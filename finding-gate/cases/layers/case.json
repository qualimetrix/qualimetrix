{
    "id": "layers",
    "description": "A layer policy with a forbidden edge, an unreachable layer, a shadowing pair, a matched pending layer, an empty template, a class outside every layer and an exclude clause that removes nothing.",
    "paths": [
        "src"
    ],
    "config": "qmx.yaml",
    "args": [
        "--rule-opt=coupling.class-rank:warning=2",
        "--rule-opt=coupling.class-rank:error=2",
        "--rule-opt=coupling.distance:max_distance_warning=2",
        "--rule-opt=coupling.distance:max_distance_error=2",
        "--rule-opt=architecture.unassigned-class:mode=error"
    ],
    "channels": [
        "architecture.coverage-gap@project",
        "architecture.empty-template@project",
        "architecture.layer-violation@class",
        "architecture.pending-layer-matched@project",
        "architecture.potential-shadow@project",
        "architecture.unassigned-class@project",
        "architecture.unmatched-exclude@project",
        "architecture.unreachable-layer@project"
    ],
    "explainSubjects": [
        "project:",
        "declaration:class:Corpus\\Layers\\Repository\\UserRepository@src/Repository/UserRepository.php"
    ]
}
