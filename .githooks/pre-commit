#!/bin/bash

# Pre-commit hook for Qualimetrix
# Runs code style and static analysis checks on changed files

set -e

echo "🔍 Running pre-commit checks..."

# Private disclosure guard: developer home paths and private project names.
# Cheapest check, so it runs first — a leak must never reach even a local commit.
echo ""
echo "🔒 Checking for private paths and terms..."
if ! bash scripts/check-private-leaks.sh --staged; then
    echo ""
    echo "❌ Refusing to commit: private path or term detected"
    exit 1
fi

# Format markdown tables in staged .md files
# Only auto-fix files that are fully staged (no unstaged changes),
# to avoid pulling unrelated working-tree changes into the commit.
STAGED_MD_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.md$' || true)
SAFE_MD_FILES=""
for f in $STAGED_MD_FILES; do
    if ! git diff --name-only -- "$f" | grep -q .; then
        SAFE_MD_FILES="$SAFE_MD_FILES $f"
    fi
done
SAFE_MD_FILES=$(echo "$SAFE_MD_FILES" | xargs)

if [ -n "$SAFE_MD_FILES" ] && command -v python3 > /dev/null 2>&1; then
    echo "📐 Formatting markdown tables..."
    python3 scripts/format-md-tables.py --in-place $SAFE_MD_FILES 2>/dev/null && git add $SAFE_MD_FILES
    echo "✅ Markdown tables OK"
    echo ""
elif [ -n "$STAGED_MD_FILES" ]; then
    echo "📐 Skipping markdown table formatting (files have unstaged changes)"
    echo ""
fi

# Get list of changed PHP files.
#
# Passing explicit paths OVERRIDES a tool's own scope, so this list may never
# reach outside what both tools declare — `paths` in phpstan.neon and the finder
# in .php-cs-fixer.dist.php — or the hook becomes silently stricter than
# `composer check` and rejects PHP that is deliberately non-conforming, such as
# the finding-gate corpus, whose fixtures exist to make rules fire.
#
# The five roots below are exactly what both tools declare, so the hook is now
# neither stricter nor narrower than the check it stands in for.
# R is in the filter because a pure rename carries content the hook would
# otherwise never see: this repository moved eighteen test files across roots
# and every one of them skipped cs-fixer and PHPStan here, green, because
# ACM excludes renames. Checking an unchanged body again costs nothing.
STAGED_PHP_FILES=$(git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '^(src|tests|governance|scripts|tools)/' \
    | grep '\.php$' \
    | grep -v 'Infrastructure/Ast/Fixtures/invalid_syntax.php' \
    | grep -v 'Infrastructure/Console/Fixtures/parser_refuses_it.php' \
    | grep -v 'Fixtures/OutputFormats/broken/src/Unparsable.php' || true)

if [ -z "$STAGED_PHP_FILES" ]; then
    echo "✅ No PHP files to check"
    exit 0
fi

echo "📝 Checking files:"
echo "$STAGED_PHP_FILES"
echo ""

# PHP-CS-Fixer: style check (check only, no fix)
echo "🎨 Running PHP-CS-Fixer (dry-run)..."
if ! vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff $STAGED_PHP_FILES 2>/dev/null; then
    echo ""
    echo "❌ Code style issues found!"
    echo "Run 'composer cs-fix' to fix them automatically"
    exit 1
fi
echo "✅ Code style OK"

# PHPStan: static analysis
echo ""
echo "🔬 Running PHPStan..."
if ! vendor/bin/phpstan analyse $STAGED_PHP_FILES --no-progress --memory-limit=512M 2>/dev/null; then
    echo ""
    echo "❌ PHPStan found issues!"
    exit 1
fi
echo "✅ PHPStan OK"

echo ""
echo "✅ All pre-commit checks passed!"
