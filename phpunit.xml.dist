<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="depends,defects"
         requireCoverageMetadata="false"
         beStrictAboutCoverageMetadata="false"
         beStrictAboutOutputDuringTests="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnPhpunitDeprecation="true"
         beStrictAboutChangesToGlobalState="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerNotices="true">

    <php>
        <ini name="memory_limit" value="512M"/>
    </php>

    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Core/Path/Unit</directory>
            <directory>tests/Core/Symbol/Unit</directory>
            <directory>tests/Core/Unit</directory>
            <directory>tests/Analysis/Policy/Architecture/Unit</directory>
            <directory>tests/Analysis/Policy/Baseline/Unit</directory>
            <directory>tests/Analysis/Policy/Inline/Unit</directory>
            <directory>tests/Analysis/Finding/Unit</directory>
            <directory>tests/Analysis/Evidence/CircularDependency/Unit</directory>
            <directory>tests/Analysis/Evidence/CodeSmell/Unit</directory>
            <directory>tests/Analysis/Evidence/Cohesion/Unit</directory>
            <directory>tests/Analysis/Evidence/Complexity/Unit</directory>
            <directory>tests/Analysis/Evidence/Coupling/Unit</directory>
            <directory>tests/Analysis/Evidence/Design/Unit</directory>
            <directory>tests/Analysis/Evidence/Maintainability/Unit</directory>
            <directory>tests/Analysis/Evidence/Security/Unit</directory>
            <directory>tests/Analysis/Evidence/Size/Unit</directory>
            <directory>tests/Analysis/Configuration/Unit</directory>
            <directory>tests/Analysis/Evidence/Duplication/Unit</directory>
            <directory>tests/Analysis/Evidence/DependencyModel/Unit</directory>
            <directory>tests/Analysis/Evidence/Measurement/Unit</directory>
            <directory>tests/Analysis/Evidence/Prioritization/Unit</directory>
            <directory>tests/Analysis/Evidence/ComputedMetrics/Unit</directory>
            <directory>tests/Analysis/Evidence/ComputedMetrics/Health/Unit</directory>
            <directory>tests/Analysis/Run/Unit</directory>
            <directory>tests/Reporting/GraphProjection/Unit</directory>
            <directory>tests/Reporting/Unit</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Reporting/Integration</directory>
            <directory>tests/Analysis/Policy/Architecture/Integration</directory>
            <directory>tests/Analysis/Policy/Baseline/Integration</directory>
            <directory>tests/Analysis/Policy/Inline/Integration</directory>
            <directory>tests/Analysis/Finding/Integration</directory>
            <directory>tests/Analysis/Configuration/Integration</directory>
            <directory>tests/Analysis/Evidence/Measurement/Integration</directory>
            <directory>tests/Analysis/Evidence/CodeSmell/Integration</directory>
            <directory>tests/Analysis/Evidence/Complexity/Integration</directory>
            <directory>tests/Analysis/Evidence/Coupling/Integration</directory>
            <directory>tests/Analysis/Evidence/Design/Integration</directory>
            <directory>tests/Analysis/Evidence/ComputedMetrics/Integration</directory>
            <directory>tests/Analysis/Run/Integration</directory>
        </testsuite>
        <testsuite name="Functional">
            <directory>tests/Analysis/Policy/Baseline/Functional</directory>
            <directory>tests/Reporting/Functional</directory>
        </testsuite>
        <testsuite name="Infrastructure">
            <directory>tests/Infrastructure</directory>
        </testsuite>
        <testsuite name="Tooling">
            <directory>tools/phpstan/tests</directory>
            <directory>scripts/promise-effect/tests</directory>
            <directory>scripts/directive-audit/tests</directory>
            <directory>scripts/directive-audit-controls/tests</directory>
            <directory>scripts/finding-gate/tests</directory>
            <directory>scripts/suppression-snapshot/tests</directory>
            <directory>scripts/rename-enumeration/tests</directory>
            <directory>scripts/health-calibration/tests</directory>
            <directory>scripts/benchmark/tests</directory>
            <directory>scripts/modular-architecture/tests</directory>
        </testsuite>
        <testsuite name="Governance">
            <directory>governance/TestSuiteHygiene</directory>
            <directory>governance/Occurrence</directory>
            <directory>governance/RuleOptionKeys</directory>
            <directory>governance/Channel</directory>
            <directory>governance/ThresholdKeys</directory>
            <directory>governance/RuleDeclaration</directory>
            <directory>governance/RatchetArtifact</directory>
            <directory>governance/PlanningRecords</directory>
            <directory>governance/DocumentationCensus</directory>
            <directory>governance/ModularOwnership</directory>
            <directory>governance/ConsoleComposition</directory>
            <directory>governance/FrameworkClassification</directory>
            <directory>governance/PackageVersion</directory>
            <directory>governance/ProjectScopeCoverage</directory>
            <directory>governance/SelectorSyntax</directory>
            <directory>governance/SuppressionOptionKeys</directory>
            <directory>governance/RepositoryEntrypoints</directory>
            <directory>governance/ConfigurationVocabulary</directory>
            <directory>governance/MeasurementVocabulary</directory>
            <directory>governance/MeasurementIdentity</directory>
            <directory>governance/GeneratedArtifactFreshness</directory>
            <directory>governance/FormatOptionKeys</directory>
            <directory>governance/DirectiveVocabulary</directory>
            <directory>governance/ControlRigLedger</directory>
            <directory>governance/HealthVocabulary</directory>
            <directory>governance/FindingVocabulary</directory>
            <directory>governance/LayerPolicyVocabulary</directory>
            <directory>governance/SymbolVocabulary</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
        <exclude>
            <directory>src/Infrastructure/Console</directory>
        </exclude>
    </source>

</phpunit>
